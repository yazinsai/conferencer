# Copy to .env.local for development. Everything here is optional —
# Conferencer runs with zero configuration.

# Signs session cookies. Set a long random value in production.
SESSION_SECRET=change-me-in-production

# Absolute URL used in emails and calendar invites.
APP_URL=http://localhost:3000

# Where the SQLite database and uploads live (default ./data).
# DATA_DIR=./data
# DATABASE_PATH=./data/conferencer.db

# Real email delivery. Without a key every message is still written to the
# in-app outbox, so nothing fails closed.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=DevFlow Conf <program@example.com>

# Protects POST /api/cron so a platform scheduler can trigger reminder emails.
# CRON_SECRET=some-long-random-string

# Optional Airtable mirror (off by default).
# AIRTABLE_API_KEY=pat_xxx
# AIRTABLE_BASE_ID=app_xxx
