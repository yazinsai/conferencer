{
  "name": "conferencer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node -e \"fs.rmSync(\\\".next/dev/types\\\",{recursive:true,force:true})\" && next typegen && tsc --noEmit",
    "seed": "tsx seed/seed.ts",
    "seed:reset": "tsx seed/seed.ts --reset",
    "seed:big": "tsx seed/big.ts",
    "cron": "tsx scripts/cron.ts",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "contrast": "node scripts/contrast.mjs",
    "media": "node scripts/media.mjs",
    "icons": "node scripts/icons.mjs",
    "audit": "node scripts/audit.mjs",
    "deploy": "docker compose up -d --build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.6",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "license": "MIT",
  "description": "Open-source conference program management (Sessionboard Program replacement)",
  "engines": {
    "node": ">=22"
  }
